pipeline {
    agent {
        label "docker-agent-label"
    }

    environment {
        APP_DIR = "apps/demo-nextjs"
        REGISTRY = "registry-1.docker.io"
        IMAGE_NAME = "zulkarnen/lgtm-demo"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        GIT_SHORT_SHA = ""
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Git Metadata') {
            steps {
                script {
                    def shortSha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    if (!shortSha) {
                        error "Failed to retrieve git short SHA"
                    }
                    env.GIT_SHORT_SHA = shortSha
                    echo "Short SHA  : ${env.GIT_SHORT_SHA}"
                    echo "Commit SHA : ${env.GIT_COMMIT}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir(APP_DIR) {
                    // Using env.GIT_SHORT_SHA directly
                    sh """
                    docker build \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                    -t ${IMAGE_NAME}:${env.GIT_SHORT_SHA} \
                    -t ${IMAGE_NAME}:latest .
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh """
                    echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:${env.GIT_SHORT_SHA}
                    docker push ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('GitOps Handoff (Update Dev)') {

            steps {
                withCredentials([
                    // You must create this credential in Jenkins containing your GitHub PAT
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )
                ]) {
                    sh """
                    # 1. Setup Git configuration
                    git config --global user.name "Jenkins CI"
                    git config --global user.email "jenkins@zulkarnen-force.local"

                    # 2. Clone the GitOps repository
                    git clone https://${GIT_USER}:${GIT_PASS}@github.com/zulkarnen-force/demo-gitops-charts.git
                    cd demo-gitops-charts

                    # 3. Update the image tag in the Dev environment using sed
                    # This finds the line starting with "tag:" and replaces it with your new short SHA
                    sed -i "s/tag: .*/tag: '${env.GIT_SHORT_SHA}'/g" overlays/dev/values-dev.yaml

                    # 4. Commit and push back to main
                    git add overlays/dev/values-dev.yaml
                    git commit -m "Deploy(dev): Update lgtm-demo to ${env.GIT_SHORT_SHA}"
                    git push origin main
                    """
                }
            }
        }

    }

    post {
        success {
            echo "Pipeline completed successfully. ArgoCD will now sync the Dev environment."
        }
        failure {
            echo "Pipeline failed."
        }
        always {
            cleanWs()
        }
    }
}
