pipeline {
    agent {
        label "docker-agent-label"
    }

    environment {
        APP_DIR = "apps/demo-nextjs"
        REGISTRY = "registry-1.docker.io"
        IMAGE_NAME = "zulkarnen/lgtm-demo"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        GIT_SHORT_SHA = "${env.GIT_COMMIT ? env.GIT_COMMIT[0..6] : 'unknown'}"
    }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir(APP_DIR) {
                    sh """
                    docker build \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                    -t ${IMAGE_NAME}:${env.GIT_SHORT_SHA} \
                    -t ${IMAGE_NAME}:latest .
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh """
                    echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:${env.GIT_SHORT_SHA}
                    docker push ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('GitOps Handoff (Update Dev)') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )
                ]) {
                    sh """
                    git config --global user.name "Jenkins CI"
                    git config --global user.email "jenkins@zulkarnen-force.local"

                    # Ensure clean directory if workspace is reused
                    rm -rf demo-gitops-charts

                    git clone https://${GIT_USER}:${GIT_PASS}@github.com/zulkarnen-force/demo-gitops-charts.git
                    cd demo-gitops-charts

                    sed -i "s/tag: .*/tag: '${env.GIT_SHORT_SHA}'/g" overlays/dev/values-dev.yaml

                    git add overlays/dev/values-dev.yaml
                    git commit -m "Deploy(dev): Update lgtm-demo to ${env.GIT_SHORT_SHA}"
                    git push origin main
                    """
                }
            }
        }

        // --- NEW STAGE: PRODUCTION PROMOTION ---
        stage('GitOps Handoff (Promote to Prod)') {
            steps {
                // 1. The Gate: The pipeline will PAUSE here indefinitely until approved
                input message: "Approve deployment of ${env.GIT_SHORT_SHA} to PRODUCTION?",
                      submitter: "admin,release-managers" // Optional: restrict who can click approve

                // 2. The Execution: If approved, it runs the Prod update
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )
                ]) {
                    sh """
                        # We change into the already cloned repo from the previous stage
                        cd demo-gitops-charts

                        # Pull the latest changes just in case something else merged while we waited
                        git pull origin main

                        # Update the PROD values file
                        sed -i "s/tag: .*/tag: '${env.GIT_SHORT_SHA}'/g" overlays/prod/values-prod.yaml

                        # Commit and push
                        git add overlays/prod/values-prod.yaml
                        git commit -m "Deploy(prod): Promote lgtm-demo to ${env.GIT_SHORT_SHA}"
                        git push origin main
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully. ArgoCD will now sync the environments."
        }
        aborted {
            echo "Production promotion was rejected/aborted by the user."
        }
        failure {
            echo "Pipeline failed."
        }
        always {
            cleanWs()
        }
    }
}
