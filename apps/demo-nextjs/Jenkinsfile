pipeline {
    agent {
        label "docker-agent-label"
    }

    environment {
        APP_DIR = "apps/demo-nextjs"
        REGISTRY = "registry-1.docker.io"
        IMAGE_NAME = "zulkarnen/lgtm-demo"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        GIT_SHORT_SHA = ""
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Git Metadata') {
            steps {
                script {
        
                    echo "GIT_COMMIT=${env.GIT_COMMIT}"
        
                    if (!env.GIT_COMMIT) {
                        error("GIT_COMMIT is empty")
                    }
        
                    env.GIT_SHORT_SHA = env.GIT_COMMIT.take(7)
        
                    echo "Short SHA = ${env.GIT_SHORT_SHA}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    docker build \
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                        -t ${IMAGE_NAME}:${GIT_SHORT_SHA} \
                        -t ${IMAGE_NAME}:latest .
                    '''
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''
                    echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" \
                        --password-stdin

                    docker push ${IMAGE_NAME}:${IMAGE_TAG}

                    docker push ${IMAGE_NAME}:latest
                    '''
                }
            }
        }

    }

    post {

        success {
            echo "Pipeline completed successfully."
        }

        failure {
            echo "Pipeline failed."
        }

        always {
            cleanWs()
        }

    }
}
